{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "screen-app",
  "version": "0.1.0",
  "identifier": "com.screen.app",
  "build": {
    "frontendDist": "../app-ui/dist",
    "beforeDevCommand": {
      "script": "env -u NO_COLOR trunk serve --port 1420",
      "cwd": "../app-ui"
    },
    "beforeBuildCommand": {
      "script": "env -u NO_COLOR trunk build --release",
      "cwd": "../app-ui"
    },
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Screen",
        "width": 1280,
        "height": 800,
        "dragDropEnabled": true,
        "resizable": true,
        "visible": false
      },
      {
        "label": "tray-popover",
        "url": "index.html?surface=recorder",
        "title": "Screen",
        "width": 500,
        "height": 540,
        "minWidth": 460,
        "minHeight": 480,
        "decorations": true,
        "resizable": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false
      },
      {
        "label": "webcam-bubble",
        "url": "index.html?mount=bubble",
        "title": "Webcam",
        "width": 260,
        "height": 300,
        "decorations": false,
        "resizable": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    },
    "macOSPrivateApi": true,
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "shortDescription": "Cinematic screen recorder",
    "longDescription": "Screen — coordinated webcam + screen + mic + system audio recording with multi-format export (MP4 / WebM).",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
