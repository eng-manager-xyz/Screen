{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "screen-app",
  "version": "0.1.0",
  "identifier": "com.screen.app",
  "build": {
    "frontendDist": "../app-ui/dist",
    "beforeDevCommand": "cd app-ui && trunk serve --port 1420",
    "beforeBuildCommand": "cd app-ui && trunk build --release",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Screen",
        "width": 1280,
        "height": 800,
        "dragDropEnabled": true,
        "resizable": true,
        "visible": false
      },
      {
        "label": "tray-popover",
        "url": "index.html?surface=recorder",
        "title": "Screen",
        "width": 1200,
        "height": 720,
        "decorations": true,
        "resizable": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": false
  }
}
