- - on-screen-options-all-on
  - "<div role=\"dialog\" class=\"popover-surface popover-bl\" style=\"width:380px;\"><header class=\"popover-header\"><div class=\"popover-title\">On-screen</div><div class=\"popover-description\">Choose what shows during recording.</div></header><div class=\"popover-body\"><ul role=\"group\" aria-label=\"On-screen options\" class=\"on-screen-options\"><li data-option=\"clean-desktop\" class=\"on-screen-option-row\"><span class=\"on-screen-option-toggle\"><button role=\"switch\" aria-checked aria-label=\"Enable clean up the desktop\" class=\"toggle toggle-on\"><span class=\"toggle-track\"><span class=\"toggle-knob\"></span></span></button></span><span class=\"on-screen-option-text\"><span class=\"on-screen-option-title\">Clean up the desktop</span><span class=\"on-screen-option-description\">Hide icons + the dock for a clean recording. Wallpaper stays.</span></span></li><li data-option=\"show-keys\" class=\"on-screen-option-row\"><span class=\"on-screen-option-toggle\"><button role=\"switch\" aria-checked aria-label=\"Enable show keys you press\" class=\"toggle toggle-on\"><span class=\"toggle-track\"><span class=\"toggle-knob\"></span></span></button></span><span class=\"on-screen-option-text\"><span class=\"on-screen-option-title\">Show keys you press</span><span class=\"on-screen-option-description\">Render ⌘C / ⌃-space badges over the recording so viewers can follow along.</span></span></li><li data-option=\"blur-sensitive-info\" class=\"on-screen-option-row\"><span class=\"on-screen-option-toggle\"><button role=\"switch\" aria-checked aria-label=\"Enable blur sensitive info\" class=\"toggle toggle-on\"><span class=\"toggle-track\"><span class=\"toggle-knob\"></span></span></button></span><span class=\"on-screen-option-text\"><span class=\"on-screen-option-title\">Blur sensitive info</span><span class=\"on-screen-option-description\">Auto-detect password fields and other sensitive regions, and blur them. Coming soon.</span></span></li><!></ul></div><footer class=\"popover-footer\"><div class=\"menu-footer\"><span style=\"font-size:11px;color:var(--text-tertiary);\">Applies to this recording</span><button class=\"btn btn-default btn-sm\">Done</button></div></footer></div>"
- - on-screen-options-default
